rtol 1E-4
derefcrit 0.2
refcrit 0.3
diffbad 20
screen
noreact
react mesa_210.net
hll
rho_0 5e5
T_0 3e8
START "1D Timmes Mix Hydrostatic test"
   LEVELS 1
   XYZ 1
      X 1 -.0025 .0025 SYMMETRIC
      SCALARS 211 ADVECT 211
   CASE TIMMIX
END
msbdf
order 1
marker 1
cns 1e-3
nsub 10000
par0 1e-5 ! velocity tolerance
par1 5000 ! nstep
par2 0.9999 ! maxmach
par3 0.0  ! delta mach tolerance
par4 0.1  ! timestep reduction near sonic pt
par5 1.0e-16 ! initial dx
par6 1.1 ! timestep increase factor
