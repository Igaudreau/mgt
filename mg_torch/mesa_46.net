add_isos_and_reactions(
   neut
   h  1  2 ! hydrogen
   he  3  4 ! helium
   li7      ! lithium
   be7
    b8      ! boron
    c 12 13 ! carbon
    n 13 15 ! nitrogen
    o 14 18 ! oxygen
    f 17 19 ! fluorine
   ne 18 20 ! neon
   na23     ! sodium
   mg 23 24 ! magnesium
   al27     ! aluminum
   si 27 28 ! silicon
   p  30 31 ! phosphorus
   s  31 32 ! sulfur
   cl35     ! chlorine
   ar36     ! argon
   k39      ! potassium
   ca40     ! calcium
   sc43     ! scandium
   ti44     ! titanium
   v47      ! vanadium
   cr48     ! chromium
   mn51	    ! manganese
   fe52     ! iron
   co55     ! cobalt
   ni56     ! nickel
   )

! for NeNa cycle, must have ne20-22, na21-23
! for MgAl cycle, must have mg24-26, al25-27
! for c12+c12 reactions, must have ne20 na23, mg23
! for c12+o16 reactions, must have mg24, al27, si27
! for o16+o16 reactions, must have si28, p30, p31, s31
