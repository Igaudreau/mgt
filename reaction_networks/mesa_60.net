   n 13 15  ! nitrogen
   o 15 18  ! oxygen
   f18      ! fluorine
   ne 19 22 ! neon
   na 12 23 ! sodium
   mg 23 26 ! magnesium
   al 25 27 ! aluminum
   si 28 30 ! silicon
   p  29 31 ! phosphorus
   s  31 33 ! sulfur
   cl 33 35 ! chlorine
   ar 36 39 ! argon
   k39      ! potassium
   ca40     ! calcium
   sc43     ! scandium
   ti44     ! titanium
   v47      ! vanadium
   cr48     ! chromium
   mn51	    ! manganese
   fe52     ! iron
   fe56     ! iron   
   co55     ! cobalt
   ni56     !nickel
   ni 58 59 ! nickel
   )

