/BeginPlot {
   gsave
   /Courier findfont Fh scalefont setfont
   0.5 setlinewidth

%clipping window
   newpath
      Xmin Ymin moveto
      Xmax Ymin lineto
      Xmax Ymax lineto
      Xmin Ymax lineto
   closepath clip
} def

/EndPlot {
   grestore
   showpage
} def

/JustShow {
   /str exch def
   /vj exch def
   /hj exch def
   /y0 exch def
   /x0 exch def
   str stringwidth pop /dw exch def
   /xc { hj 0.5 mul dw mul x0 exch sub} def
   /yc { vj 0.375 mul Fh mul y0 exch sub } def
   xc yc moveto str show
   200 200 moveto
} def

/Vector {
   /y2 exch def
   /x2 exch def
   /y1 exch def
   /x1 exch def
   newpath
      x1 y1 moveto
      x2 y2 lineto
   stroke
} def

/Rect {
   /colour exch def
   /y2 exch def
   /y1 exch def
   /x2 exch def
   /x1 exch def
   colour setgray
   newpath
      x1 y1 moveto
      x2 y1 lineto
      x2 y2 lineto
      x1 y2 lineto
   closepath fill
   0.0 setgray
} def
/Block {
   /y2 exch def
   /y1 exch def
   /x2 exch def
   /x1 exch def
   newpath
      x1 y1 moveto
      x2 y1 lineto
      x2 y2 lineto
      x1 y2 lineto
   closepath fill
} def

% emulate "colorimage"
/bwproc {
   rgbproc
   dup length 3 idiv string 0 3 0
   5 -1 roll {
      add 2 1 roll 1 sub dup 0 eq
      {
         pop 3 idiv 3 -1 roll dup 4 -1 roll dup
         3 1 roll 5 -1 roll put 1 add 3 0
      } {2 1 roll} ifelse
   } forall
   pop pop pop
} def
systemdict /colorimage known not {
   /colorimage {
      pop
      pop
      /rgbproc exch def
      { bwproc } image
   } def
} if
